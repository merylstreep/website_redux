---
import { person } from '@/content/site';

const nav = [
  ['About', '#about'],
  ['Talks', '#talks'],
  ['Writing', '#writing'],
  ['Contact', '#contact'],
] as const;
---

<header class="header wrap">
  <a class="home" href="/" aria-label="Home">
    <span aria-hidden="true">{person.emoji}</span>
  </a>
  <nav aria-label="Sections">
    <ul>
      {nav.map(([label, href]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    font-size: var(--text-sm);
  }
  .home {
    text-decoration: none;
    font-size: 1.25rem;
    line-height: 1;
  }
  ul {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
  }
</style>
