---
interface Props {
  links: { label: string; url: string; note?: string }[];
}
const { links } = Astro.props;
const live = links.filter((l) => l.url);
---

<ul class="links">
  {
    live.map((l) => (
      <li>
        <a href={l.url} rel="me noopener" target={l.url.startsWith('#') ? undefined : '_blank'}>
          {l.label}
          <span aria-hidden="true">↗</span>
        </a>
        {l.note && <span class="note">{l.note}</span>}
      </li>
    ))
  }
</ul>

<style>
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  a {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
  }
  a span {
    color: var(--accent);
    font-size: 0.8em;
    transition: transform 200ms var(--ease);
  }
  a:hover span {
    transform: translate(0.12em, -0.12em);
  }
  .note {
    color: var(--ink-2);
  }
</style>
