---
import type { LinkItem } from '@/content/site';

interface Props {
  links: LinkItem[];
}
const { links } = Astro.props;
---

<ul class="rows">
  {
    links.map((l) => (
      <li>
        <span class="muted">{l.label}</span>
        <div>
          {l.url ? (
            <a href={l.url} rel="me noopener">
              {l.handle}
            </a>
          ) : (
            <span>{l.handle}</span>
          )}
          {l.note && <p class="muted note" set:html={l.note} />}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .rows {
    display: grid;
    gap: 0.6rem;
  }
  li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.1rem 1rem;
    align-items: baseline;
  }
  .note {
    font-size: var(--text-sm);
    margin-top: 0.15rem;
  }
  @media (max-width: 28rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
