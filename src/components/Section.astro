---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  .section {
    margin-top: var(--space-section);
    scroll-margin-top: 1.5rem;
  }
  h2 {
    font-size: var(--text-md);
    margin-bottom: 1rem;
  }
</style>
