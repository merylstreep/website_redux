---
import type { Talk } from '@/content/site';
import Empty from './Empty.astro';

interface Props {
  talks: Talk[];
}
const { talks } = Astro.props;
const sorted = [...talks].sort((a, b) => b.date.localeCompare(a.date));
const fmt = new Intl.DateTimeFormat('en-AU', { month: 'short', year: 'numeric' });
---

{
  sorted.length === 0 ? (
    <Empty what="Talks" />
  ) : (
    <ol class="talks">
      {sorted.map((t) => (
        <li>
          <time class="mono muted" datetime={t.date}>
            {fmt.format(new Date(t.date))}
          </time>
          <div>
            <h3>{t.title}</h3>
            <p class="muted">
              {t.event}
              {t.location && ` · ${t.location}`}
            </p>
            {(t.slides || t.video) && (
              <p class="links">
                {t.slides && <a href={t.slides}>Slides</a>}
                {t.video && <a href={t.video}>Video</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .talks {
    display: grid;
    gap: 1.25rem;
  }
  li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.15rem 1rem;
  }
  time {
    padding-top: 0.2rem;
  }
  h3 {
    font-size: var(--text);
    font-weight: 500;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
  }
  @media (max-width: 28rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
