---
import type { Talk } from '@/content/site';
import Empty from './Empty.astro';

interface Props {
  talks: Talk[];
}
const { talks } = Astro.props;
const sorted = [...talks].sort((a, b) => b.date.localeCompare(a.date));
const fmt = new Intl.DateTimeFormat('en-AU', { month: 'short', year: 'numeric' });
---

{
  sorted.length === 0 ? (
    <Empty what="Talks" />
  ) : (
    <ol class="talks" reversed>
      {sorted.map((t) => (
        <li>
          <time class="label" datetime={t.date}>
            {fmt.format(new Date(t.date))}
          </time>
          <div>
            <h3>{t.title}</h3>
            <p class="where">
              {t.event}
              {t.location && <span> · {t.location}</span>}
            </p>
            {(t.slides || t.video) && (
              <p class="links label">
                {t.slides && <a href={t.slides}>Slides</a>}
                {t.video && <a href={t.video}>Video</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
  }
  time {
    padding-top: 0.2rem;
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: var(--step-1);
  }
  .where {
    color: var(--ink-2);
    margin: 0.15rem 0 0;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.4rem;
  }
  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
