---
import type { Talk } from '@/content/site';
import Empty from './Empty.astro';

interface Props {
  talks: Talk[];
}
const { talks } = Astro.props;

const sorted = [...talks].sort((a, b) => a.start.localeCompare(b.start));
const byYear = new Map<string, Talk[]>();
for (const t of sorted) {
  const y = t.start.slice(0, 4);
  byYear.set(y, [...(byYear.get(y) ?? []), t]);
}

const day = (iso: string) => String(Number(iso.slice(8, 10)));
const mon = (iso: string) =>
  new Intl.DateTimeFormat('en-AU', { month: 'short', timeZone: 'UTC' }).format(new Date(iso));

/** "27–28 Aug", "1–2 Oct", "10 Oct", or "30 Sep – 2 Oct" across a month boundary. */
function range(t: Talk) {
  if (!t.end || t.end === t.start) return `${day(t.start)} ${mon(t.start)}`;
  if (t.start.slice(0, 7) === t.end.slice(0, 7)) return `${day(t.start)}–${day(t.end)} ${mon(t.start)}`;
  return `${day(t.start)} ${mon(t.start)} – ${day(t.end)} ${mon(t.end)}`;
}
---

{
  sorted.length === 0 ? (
    <Empty what="Talks" />
  ) : (
    <div class="years">
      {[...byYear].map(([year, list]) => (
        <section class="year" aria-label={year}>
          <h3 class="num muted">{year}</h3>
          <ol>
            {list.map((t) => (
              <li>
                <time class="num muted" datetime={t.end ? `${t.start}/${t.end}` : t.start}>
                  {range(t)}
                </time>
                <div class="talk">
                  <p class="title serif">{t.title}</p>
                  <p class="muted event">
                    {t.url ? <a href={t.url}>{t.event}</a> : t.event}
                    {t.location && <span class="loc">{t.location}</span>}
                  </p>
                  {(t.slides || t.video) && (
                    <p class="links">
                      {t.slides && <a href={t.slides}>Slides</a>}
                      {t.video && <a href={t.video}>Video</a>}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )
}

<style>
  .years {
    display: grid;
    gap: 1.75rem;
  }
  h3 {
    font-weight: 400;
    margin-bottom: 0.75rem;
  }
  ol {
    display: grid;
    gap: 1.1rem;
  }
  li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.1rem 1rem;
  }
  time {
    padding-top: 0.25rem;
    white-space: nowrap;
  }
  .title {
    font-size: var(--text-serif);
    font-weight: 500;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .event {
    font-size: var(--text-sm);
    margin-top: 0.15rem;
  }
  .loc::before {
    content: ', ';
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
  }
  @media (max-width: 28rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
