---
import type { WorkItem } from '@/content/site';
import Empty from './Empty.astro';

interface Props {
  items: WorkItem[];
}
const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <Empty what="Recent work" />
  ) : (
    <ul class="work">
      {items.map((w) => (
        <li>
          <div class="row">
            <h3>{w.url ? <a href={w.url}>{w.title}</a> : w.title}</h3>
            {w.year && <span class="mono muted">{w.year}</span>}
          </div>
          <p class="muted">{w.description}</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .work {
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  h3 {
    font-size: var(--text);
    font-weight: 500;
  }
</style>
