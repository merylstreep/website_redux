---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Section from '@/components/Section.astro';
import TalkList from '@/components/TalkList.astro';
import LinkRows from '@/components/LinkRows.astro';
import { person, about, talks, writing, contact } from '@/content/site';
---

<Base>
  <a class="visually-hidden" href="#about">Skip to content</a>
  <Header />

  <main class="wrap">
    <section class="intro" id="about" aria-labelledby="name">
      <h1 id="name">
        {person.name} <span class="alt">{person.altName}</span>
      </h1>
      <p class="muted where">{person.location}</p>
      <div class="about">
        {about.map((para) => <p set:html={para} />)}
      </div>
    </section>

    <Section id="talks" title="Talks">
      <TalkList talks={talks} />
    </Section>

    <Section id="writing" title="Writing">
      <LinkRows links={writing} />
    </Section>

    <Section id="contact" title="Contact">
      <LinkRows links={contact} />
    </Section>
  </main>

  <footer class="wrap muted">
    <span aria-hidden="true">{person.emoji}</span>
    <span class="mono">{new Date().getFullYear()}</span>
    <a href="https://github.com/merylstreep/website_redux">Source</a>
  </footer>
</Base>

<style>
  .intro {
    padding-top: 2.5rem;
  }
  h1 {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .alt {
    font-weight: 400;
    color: var(--ink-2);
    margin-left: 0.15em;
  }
  .where {
    margin-top: 0.25rem;
  }
  .about {
    margin-top: 1.5rem;
  }
  footer {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-top: var(--space-section);
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
  }
</style>
